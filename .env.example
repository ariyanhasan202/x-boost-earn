# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM BOT INTEGRATION
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_BOT_USERNAME="xboost_earn_bot"
VITE_TELEGRAM_BOT_USERNAME="xboost_earn_bot"

# TELEGRAM GROUP IDs (Include leading '-' or '-100' for supergroups)
# Group where withdrawal requests are sent and admin replies update status
TELEGRAM_WITHDRAW_GROUP_ID="-1001234567890"

# Group where first-time new user /start notifications are sent
TELEGRAM_NEW_USER_GROUP_ID="-1001234567890"

# Optional comma-separated Admin Telegram User IDs allowed to update status (leave empty to allow all group admins)
TELEGRAM_ADMIN_IDS=""

# SUPABASE (Optional, fallback to persistent local database store in data/supabase_store.json)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-secret"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
